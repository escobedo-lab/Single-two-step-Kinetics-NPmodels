
units		real
atom_style	full
pair_style      sw
atom_modify     map array sort 0 0.0


read_data       NPT1_new.lmp



pair_coeff * * epsA.B.sw A B

neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes


 
# -- Run section --
compute thermo_ke all ke

# -- Run section --

fix 1 all nve
run     0

