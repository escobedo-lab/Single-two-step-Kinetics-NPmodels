units		real
atom_style	full
pair_style      sw
atom_modify     map array sort 0 0.0

read_data	NPT1.lmp


pair_coeff * * eps.swpoly T S


neighbor        2.0 bin
neigh_modify    every 2 delay 6 check yes



 
# -- Run section --
compute thermo_ke all ke
timestep   ${dt}

# -- Run section --
velocity        all create 636 ${seed} dist gaussian mom yes



fix 1 all nve
run     0
#unfix 1

